/**
 * 帮派效果配置
 * 
 * 数据来源: StaticDataAccess.GetOrgnizeEffectDate()
 * 用途: 帮派系统 - 帮派等级效果加成
 */

export interface OrgEffect {
  level: number;              // 帮派等级
  memberShipNum: number;       // 成员数量上限
  officialNum: number;        // 官职数量
  additionalMoney: number;     // 金钱产量加成 (%)
  additionalGrain: number;     // 粮草产量加成 (%)
  additionalMen: number;       // 人口产量加成 (%)
  needPearl: number;          // 升级需要珍珠
  needCrystal: number;        // 升级需要水晶
  needAgate: number;          // 升级需要玛瑙
  needWBowlder: number;       // 升级需要白玉石
  needBBowlder: number;       // 升级需要黑玉石
  needJadeBook: number;       // 升级需要玉书
}

