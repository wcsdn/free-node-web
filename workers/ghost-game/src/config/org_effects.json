export const maxOrgLevel = orgEffects.length;

/**
 * 根据等级获取帮派效果
 */
export function getOrgEffectByLevel(level: number): OrgEffect | null {
  if (level < 1 || level > maxOrgLevel) {
    return null;
  }
  return orgEffects[level - 1];
}

/**
 * 获取所有帮派效果
 */
export function getAllOrgEffects(): OrgEffect[] {
  return orgEffects;
}
